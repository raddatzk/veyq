{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "veyq chart values",
  "description": "The shapes the operator's values must have. Helm applies this to install, upgrade, lint AND template, naming the path and the pattern of a violation — which is why nothing here has a generated fallback: a value the chart cannot assert is a value the chart does not supply.",
  "type": "object",
  "required": ["domain", "storeDomain", "image", "admin", "gateway", "networkPolicy", "secrets", "mariadb", "externalDatabase", "garage"],
  "$defs": {
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
    },
    "imageRef": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "pattern": "^[^<>\\s]+$" },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "nonEmpty": { "type": "string", "minLength": 1 }
  },
  "properties": {
    "domain": { "$ref": "#/$defs/hostname" },
    "storeDomain": { "$ref": "#/$defs/hostname" },
    "hsts": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "image": { "$ref": "#/$defs/imageRef" },
    "app": {
      "type": "object",
      "properties": {
        "trustedProxies": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "$comment": "ingressFrom is required while enabled, and never defaulted: the gateway data plane's namespace and labels are the operator's (ADR 0071 §3), so the chart refuses to guess and an install without it fails naming the key.",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array", "items": { "type": "object", "minProperties": 1 } }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "required": ["ingressFrom"], "properties": { "ingressFrom": { "minItems": 1 } } }
    },
    "admin": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": { "$ref": "#/$defs/imageRef" },
        "domain": {
          "anyOf": [
            { "type": "string", "maxLength": 0 },
            { "$ref": "#/$defs/hostname" }
          ]
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["className", "tls"],
      "$comment": "className is required and never defaulted: a Gateway cannot omit its gatewayClassName, and which implementation serves it is the operator's choice (ADR 0064) — the chart names none.",
      "properties": {
        "className": { "$ref": "#/$defs/nonEmpty" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tls": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "type": "string", "enum": ["none", "per-domain", "shared"] },
            "secretName": { "type": "string", "maxLength": 253 },
            "acme": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "email": { "type": "string" },
                "server": { "type": "string", "pattern": "^https://[^\\s]+$" }
              }
            }
          },
          "if": { "properties": { "mode": { "const": "shared" } } },
          "then": { "properties": { "secretName": { "$ref": "#/$defs/nonEmpty" } }, "required": ["secretName"] }
        }
      },
      "$comment": "The ACME opt-in's contradictions are refused here, never resolved in a template: an acme issuer obtains per-domain certificates, so any other mode is an operator's explicit choice the chart must not override; the e-mail is required as compose requires VEYQ_ACME_EMAIL; and an operator's own issuer annotation beside the chart's would leave cert-manager to pick one. The annotation keys are forbidden as `false` schemas so the refusal names the key.",
      "if": {
        "required": ["tls"],
        "properties": { "tls": { "required": ["acme"], "properties": { "acme": { "required": ["enabled"], "properties": { "enabled": { "const": true } } } } } }
      },
      "then": {
        "properties": {
          "tls": {
            "properties": {
              "mode": { "const": "per-domain" },
              "acme": { "required": ["email", "server"], "properties": { "email": { "$ref": "#/$defs/nonEmpty" }, "server": { "$ref": "#/$defs/nonEmpty" } } }
            }
          },
          "annotations": {
            "properties": {
              "cert-manager.io/issuer": false,
              "cert-manager.io/cluster-issuer": false
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "mariadbPassword": { "type": "string" },
        "mariadbRootPassword": { "type": "string" },
        "garageRpcSecret": { "type": "string" },
        "garageAdminToken": { "type": "string" }
      },
      "if": { "properties": { "existingSecret": { "maxLength": 0 } } },
      "then": {
        "required": ["mariadbPassword", "mariadbRootPassword", "garageRpcSecret", "garageAdminToken"],
        "properties": {
          "mariadbPassword": { "$ref": "#/$defs/nonEmpty" },
          "mariadbRootPassword": { "$ref": "#/$defs/nonEmpty" },
          "garageRpcSecret": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "garageAdminToken": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "mariadb": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "jdbcUrl": { "type": "string" },
        "username": { "type": "string" }
      }
    },
    "garage": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  },
  "if": { "properties": { "mariadb": { "properties": { "enabled": { "const": false } } } } },
  "then": {
    "properties": {
      "externalDatabase": {
        "required": ["jdbcUrl"],
        "properties": { "jdbcUrl": { "type": "string", "pattern": "^jdbc:mariadb://.+" } }
      }
    }
  }
}
