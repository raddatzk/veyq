{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "veyq chart values",
  "description": "The shapes the operator's values must have. Helm applies this to install, upgrade, lint AND template, naming the path and the pattern of a violation — which is why nothing here has a generated fallback: a value the chart cannot assert is a value the chart does not supply.",
  "type": "object",
  "required": ["domain", "storeDomain", "image", "admin", "ingress", "secrets", "mariadb", "externalDatabase", "garage"],
  "$defs": {
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
    },
    "imageRef": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "pattern": "^[^<>\\s]+$" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "nonEmpty": { "type": "string", "minLength": 1 }
  },
  "properties": {
    "domain": { "$ref": "#/$defs/hostname" },
    "storeDomain": { "$ref": "#/$defs/hostname" },
    "image": { "$ref": "#/$defs/imageRef" },
    "admin": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": { "$ref": "#/$defs/imageRef" },
        "domain": {
          "anyOf": [
            { "type": "string", "maxLength": 0 },
            { "$ref": "#/$defs/hostname" }
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["tls"],
      "properties": {
        "className": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tls": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "type": "string", "enum": ["none", "per-domain", "shared"] },
            "secretName": { "type": "string", "maxLength": 253 }
          },
          "if": { "properties": { "mode": { "const": "shared" } } },
          "then": { "properties": { "secretName": { "$ref": "#/$defs/nonEmpty" } }, "required": ["secretName"] }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "mariadbPassword": { "type": "string" },
        "mariadbRootPassword": { "type": "string" },
        "garageRpcSecret": { "type": "string" },
        "garageAdminToken": { "type": "string" },
        "s3AccessKey": { "type": "string" },
        "s3SecretKey": { "type": "string" }
      },
      "if": { "properties": { "existingSecret": { "maxLength": 0 } } },
      "then": {
        "required": ["mariadbPassword", "mariadbRootPassword", "garageRpcSecret", "garageAdminToken", "s3AccessKey", "s3SecretKey"],
        "properties": {
          "mariadbPassword": { "$ref": "#/$defs/nonEmpty" },
          "mariadbRootPassword": { "$ref": "#/$defs/nonEmpty" },
          "garageRpcSecret": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "garageAdminToken": { "$ref": "#/$defs/nonEmpty" },
          "s3AccessKey": { "type": "string", "pattern": "^GK[0-9a-f]{24}$" },
          "s3SecretKey": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "mariadb": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "jdbcUrl": { "type": "string" },
        "username": { "type": "string" }
      }
    },
    "garage": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  },
  "if": { "properties": { "mariadb": { "properties": { "enabled": { "const": false } } } } },
  "then": {
    "properties": {
      "externalDatabase": {
        "required": ["jdbcUrl"],
        "properties": { "jdbcUrl": { "type": "string", "pattern": "^jdbc:mariadb://.+" } }
      }
    }
  }
}
