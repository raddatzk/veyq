---
// The project website: what veyq is, the applications that exist, why it is needed, and the way into the docs.
// Rendered by site/src/pages/index.astro (English) and de/index.astro (German). It is a plain Astro page, not a
// Starlight one, and it loads nothing from a third party: no web font, no analytics, no CDN — the front door of an
// operator-blind product should not report its readers to anyone.
import logoLight from '../../assets/website/logo-light.svg';
import logoDark from '../../assets/website/logo-dark.svg';
import Shot from './Shot.astro';
import { getCollection } from 'astro:content';
import { languages, localePath, strings, type Lang } from './strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Docs links stay in the reader's language. Run and Security are English by design; under a locale Starlight serves
// them as fallback pages, so the sidebar around them still speaks the reader's language. starlight-links-validator
// checks the docs' own content only, not this page, so a link to a docs page that does not exist fails the build here.
const docIds = new Set((await getCollection('docs')).map((entry) => entry.id));
const doc = (path: string) => {
  if (!docIds.has(path.replace(/\/$/, ''))) throw new Error(`The website links a docs page that does not exist: ${path}`);
  return base + localePath(lang, path);
};
const home = (l: Lang) => base + localePath(l);
const source = 'https://github.com/raddatzk/veyq';

const featureIcons = [
  // spaces: three overlapping circles
  '<circle cx="9" cy="10" r="5"/><circle cx="15" cy="10" r="5"/><circle cx="12" cy="15" r="5"/>',
  // share: a link
  '<path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/>',
  // quantum: an atom
  '<circle cx="12" cy="12" r="1.5"/><ellipse cx="12" cy="12" rx="9" ry="3.6"/><ellipse cx="12" cy="12" rx="9" ry="3.6" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="9" ry="3.6" transform="rotate(120 12 12)"/>',
  // export: a box with an arrow out
  '<path d="M4 8l8-4 8 4v8l-8 4-8-4z"/><path d="M12 12v8M4 8l8 4 8-4"/>',
  // recovery: a key
  '<circle cx="8" cy="15" r="4"/><path d="M11 12l8-8M16 7l2 2M14 9l2 2"/>',
  // devices: a phone beside a laptop
  '<rect x="3" y="5" width="13" height="9" rx="1.5"/><path d="M1.5 17h16"/><rect x="17" y="8" width="5.5" height="11" rx="1.2"/>',
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.htmlTitle}</title>
    <meta name="description" content={t.description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={logoLight.src} />
    {languages.map((l) => <link rel="alternate" hreflang={l.code} href={new URL(home(l.code), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(home(languages[0].code), Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href={home(lang)} aria-label="veyq">
          <picture>
            <source srcset={logoDark.src} media="(prefers-color-scheme: dark)" />
            <img src={logoLight.src} alt="" width="26" height="28" />
          </picture>
          <span>veyq</span>
        </a>
        <nav aria-label={t.nav.main}>
          <a href="#apps">{t.nav.apps}</a>
          <a href="#how">{t.nav.how}</a>
          <a href="#run">{t.nav.run}</a>
        </nav>
        <div class="top-actions">
          <ul class="langs" aria-label={t.nav.language}>
            {
              languages.map((l) => (
                <li>
                  <a
                    href={home(l.code)}
                    hreflang={l.code}
                    lang={l.code}
                    aria-current={l.code === lang ? 'page' : undefined}
                    title={l.label}
                  >
                    {l.code.toUpperCase()}
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="btn btn-small" href={doc('start/')}>{t.nav.docs}</a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="wrap">
          <ul class="eyebrow">
            {t.hero.eyebrow.map((e) => <li>{e}</li>)}
          </ul>
          <h1>{t.hero.title}</h1>
          <p class="lead">{t.hero.lead}</p>
          <div class="ctas">
            <a class="btn" href={doc('getting-started/')}>{t.hero.primary}</a>
            <a class="btn btn-ghost" href={doc('run/')}>{t.hero.secondary}</a>
          </div>
          <p class="status"><span class="dot" aria-hidden="true"></span>{t.hero.status}</p>
          <div class="hero-shot">
            <Shot id={t.hero.shotId} lang={lang} shows={t.hero.shot} placeholder={t.placeholder} eager />
          </div>
        </div>
      </section>

      <section class="story" aria-labelledby="story-title">
        <div class="wrap narrow">
          <p class="kicker">{t.story.kicker}</p>
          <h2 id="story-title">{t.story.title}</h2>
          {t.story.paragraphs.map((p) => <p>{p}</p>)}
          <blockquote>{t.story.quote}</blockquote>
        </div>
      </section>

      <section id="apps" class="section" aria-labelledby="apps-title">
        <div class="wrap">
          <div class="section-head">
            <p class="kicker">{t.apps.kicker}</p>
            <h2 id="apps-title">{t.apps.title}</h2>
            <p class="section-lead">{t.apps.lead}</p>
          </div>
          <div class="apps">
            {
              t.apps.items.map((app) => (
                <article class="app">
                  <Shot id={app.shot} lang={lang} shows={app.shotShows} placeholder={t.placeholder} />
                  <div class="app-body">
                    <p class="tag">{app.tag}</p>
                    <h3>{app.name}</h3>
                    <p>{app.text}</p>
                    <ul class="ticks">
                      {app.points.map((pt) => <li>{pt}</li>)}
                    </ul>
                    <a class="more" href={doc(app.link)}>{app.linkLabel} →</a>
                  </div>
                </article>
              ))
            }
          </div>
          <aside class="next">
            <span class="next-plus" aria-hidden="true">+</span>
            <div>
              <p class="tag">{t.apps.next.tag}</p>
              <h3>{t.apps.next.name}</h3>
              <p>{t.apps.next.text}</p>
            </div>
          </aside>
          <p class="center"><a class="more" href={doc('applications/')}>{t.apps.more} →</a></p>
        </div>
      </section>

      <section id="how" class="section tinted" aria-labelledby="how-title">
        <div class="wrap">
          <div class="section-head">
            <p class="kicker">{t.how.kicker}</p>
            <h2 id="how-title">{t.how.title}</h2>
          </div>
          <ol class="steps">
            {
              t.how.steps.map((s, i) => (
                <li>
                  <span class="num" aria-hidden="true">{i + 1}</span>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </li>
              ))
            }
          </ol>
          <aside class="sees">
            <h3>{t.how.seesTitle}</h3>
            <p>{t.how.sees}</p>
            <p class="links">
              {t.how.seesLinks.map((l) => <a href={doc(l.path)}>{l.label} →</a>)}
            </p>
          </aside>
        </div>
      </section>

      <section class="section" aria-labelledby="features-title">
        <div class="wrap">
          <div class="section-head">
            <p class="kicker">{t.features.kicker}</p>
            <h2 id="features-title">{t.features.title}</h2>
          </div>
          <ul class="features">
            {
              t.features.items.map((f, i) => (
                <li>
                  <a href={doc(f.link)}>
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={featureIcons[i]} />
                    <h3>{f.title}</h3>
                    <p>{f.text}</p>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section id="run" class="section run" aria-labelledby="run-title">
        <div class="wrap run-inner">
          <div>
            <p class="kicker">{t.run.kicker}</p>
            <h2 id="run-title">{t.run.title}</h2>
            <p>{t.run.text}</p>
            <p class="honest">{t.run.honest}</p>
            <p class="links">
              {t.run.links.map((l) => <a href={doc(l.path)}>{l.label} →</a>)}
            </p>
          </div>
          <ul class="stack" aria-label="veyq instance">
            <li><strong>app</strong><span>web client + API</span></li>
            <li><strong>admin</strong><span>Server-Owner console, localhost only</span></li>
            <li><strong>mariadb</strong><span>ciphertext + opaque metadata</span></li>
            <li><strong>garage</strong><span>S3-compatible, sealed blobs</span></li>
            <li><strong>traefik</strong><span>TLS, the only public ports</span></li>
          </ul>
        </div>
      </section>

      <section class="section" aria-labelledby="docs-title">
        <div class="wrap">
          <div class="section-head">
            <p class="kicker">{t.docs.kicker}</p>
            <h2 id="docs-title">{t.docs.title}</h2>
          </div>
          <ul class="docs">
            {
              t.docs.items.map((d) => (
                <li>
                  <a href={doc(d.path)}>
                    <h3>{d.title} →</h3>
                    <p>{d.who}</p>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <div>
          <p>{t.footer.license}</p>
          <p class="muted">{t.footer.privacy}</p>
        </div>
        <p class="foot-links">
          <a href={source}>{t.footer.source}</a>
          <a href={doc('security/reporting/')}>{t.footer.report}</a>
          {
            languages
              .filter((l) => l.code !== lang)
              .map((l) => (
                <a href={home(l.code)} hreflang={l.code} lang={l.code}>
                  {l.label}
                </a>
              ))
          }
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaff;
    --surface: #ffffff;
    --surface-muted: #f5f4fb;
    --soft: #efedfb;
    --ink: #15132b;
    --muted: #5d5f74;
    --line: #e5e3f1;
    --line-strong: #cfcbe6;
    --brand: #584fff;
    --brand-deep: #332e94;
    --brand-ink: #ffffff;
    --violet: #8b57ec;
    --tint: #f3f1ff;
    --run-bg: #15132b;
    --run-ink: #eeedf8;
    --run-muted: #b6b3cf;
    --shadow: 0 24px 60px -24px rgb(51 46 148 / 0.35), 0 2px 6px rgb(21 19 43 / 0.06);
    --font: Inter, 'Avenir Next', 'Segoe UI', system-ui, -apple-system, sans-serif;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0e0d18;
      --surface: #17162a;
      --surface-muted: #1d1c33;
      --soft: #222039;
      --ink: #eeedf8;
      --muted: #a6a4bf;
      --line: #2a2843;
      --line-strong: #3b3860;
      --brand: #9b8cff;
      --brand-deep: #c4bbff;
      --brand-ink: #120f2e;
      --violet: #b393ff;
      --tint: #131224;
      --run-bg: #1a1830;
      --shadow: 0 24px 60px -24px rgb(0 0 0 / 0.7), 0 2px 6px rgb(0 0 0 / 0.3);
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 72px;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: var(--brand);
  }
  h1,
  h2,
  h3 {
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .wrap {
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: 0 24px;
  }
  .narrow {
    width: min(720px, 100%);
  }
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 16px;
    z-index: 10;
    background: var(--surface);
    padding: 8px 12px;
    border-radius: 8px;
  }

  /* header */
  .top {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .top-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }
  .brand img {
    display: block;
    height: 28px;
    width: auto;
  }
  .top nav {
    display: flex;
    gap: 22px;
    margin-right: auto;
  }
  .top nav a,
  .langs a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.93rem;
  }
  .top nav a:hover,
  .langs a:hover {
    color: var(--ink);
  }
  .langs {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 2px;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .langs a {
    display: block;
    padding: 2px 9px;
    border-radius: 999px;
    font-size: 0.78rem !important;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .langs a[aria-current='page'] {
    background: var(--soft);
    color: var(--ink);
  }
  .top-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-left: auto;
  }

  /* buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.3rem;
    border-radius: 999px;
    background: var(--brand);
    color: var(--brand-ink);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--brand);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px -8px var(--brand);
  }
  .btn-ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .btn-ghost:hover {
    box-shadow: none;
    border-color: var(--brand);
  }
  .btn-small {
    padding: 0.45rem 0.95rem;
    font-size: 0.9rem;
  }

  /* hero */
  .hero {
    position: relative;
    padding: 72px 0 0;
    text-align: center;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto;
    height: 720px;
    background:
      radial-gradient(40% 50% at 30% 30%, color-mix(in srgb, var(--brand) 22%, transparent), transparent 70%),
      radial-gradient(35% 45% at 72% 22%, color-mix(in srgb, var(--violet) 20%, transparent), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .eyebrow {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 10px;
    padding: 0;
    margin: 0 0 22px;
    list-style: none;
  }
  .eyebrow li {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 500;
  }
  .hero h1 {
    max-width: 15ch;
    margin: 0 auto;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }
  .lead {
    max-width: 60ch;
    margin: 22px auto 0;
    color: var(--muted);
    font-size: 1.15rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 0 4px rgb(245 158 11 / 0.18);
  }
  .hero-shot {
    margin: 56px auto 0;
    max-width: 1072px;
    transform: translateY(1px);
  }

  /* story */
  .story {
    padding: 112px 0 40px;
    font-size: 1.12rem;
  }
  .story h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.5rem);
    margin-bottom: 18px;
  }
  .story p {
    color: var(--muted);
  }
  .story blockquote {
    margin: 36px 0 0;
    padding: 4px 0 4px 24px;
    border-left: 3px solid var(--brand);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  /* sections */
  .section {
    padding: 104px 0;
  }
  .tinted {
    background: var(--tint);
    border-block: 1px solid var(--line);
  }
  .section-head {
    max-width: 720px;
    margin-bottom: 48px;
  }
  .section-head h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.5rem);
  }
  .section-lead {
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .kicker {
    margin: 0 0 10px;
    color: var(--brand);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .more {
    font-weight: 600;
    text-decoration: none;
  }
  .more:hover {
    text-decoration: underline;
  }
  .center {
    text-align: center;
    margin: 40px 0 0;
  }

  /* applications */
  .apps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
  .app {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .app-body h3 {
    font-size: 1.6rem;
    margin: 2px 0 8px;
  }
  .app-body p {
    margin: 0;
    color: var(--muted);
  }
  .tag {
    color: var(--violet) !important;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .ticks {
    margin: 16px 0 18px;
    padding: 0;
    list-style: none;
  }
  .ticks li {
    position: relative;
    padding-left: 26px;
    margin: 6px 0;
  }
  .ticks li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.5em;
    width: 12px;
    height: 7px;
    border-left: 2px solid var(--brand);
    border-bottom: 2px solid var(--brand);
    transform: rotate(-45deg);
  }

  .next {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    margin-top: 28px;
    padding: 28px;
    border-radius: 16px;
    border: 1px dashed var(--line-strong);
    background: var(--surface);
  }
  .next h3 {
    font-size: 1.25rem;
    margin: 2px 0 6px;
  }
  .next p {
    margin: 0;
    color: var(--muted);
  }
  .next-plus {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--soft);
    color: var(--brand);
    font-size: 1.8rem;
    font-weight: 300;
    line-height: 1;
  }

  /* how it works */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .steps li {
    position: relative;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .steps h3 {
    font-size: 1.15rem;
    margin: 14px 0 8px;
  }
  .steps p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--brand), var(--violet));
    color: #fff;
    font-weight: 700;
  }
  .sees {
    margin-top: 20px;
    padding: 24px 28px;
    border-radius: 16px;
    border: 1px dashed var(--line-strong);
  }
  .sees h3 {
    font-size: 1rem;
    margin-bottom: 6px;
  }
  .sees p {
    margin: 0;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 12px !important;
  }
  .links a {
    font-weight: 600;
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }

  /* features */
  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .features a {
    display: block;
    height: 100%;
    padding: 26px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
