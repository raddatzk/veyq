# Template for infra/.env, which infra/docker-compose.prod.yml reads and .gitignore excludes.
#
#     cp infra/.env.example infra/.env      # then fill in every value below
#
# Every variable here is REQUIRED except where noted: the compose file declares them as `${VAR:?…}`, so a
# missing one fails the `up` instead of defaulting to something. A prod stack that boots with a placeholder is
# worse than one that refuses to boot.
#
# Generate the three random secrets with:
#     openssl rand -hex 32          # GARAGE_RPC_SECRET (must be exactly 64 hex chars)
#     openssl rand -base64 24       # MARIADB_* and GARAGE_ADMIN_TOKEN
#
# This file is the operator's copy of the instance's identity. Losing MARIADB_PASSWORD locks you out of your
# own database; losing the config-secret KEK on the `veyq-config-secret` volume is the separate, quieter loss
# that infra/README.md § Backup & restore is about.

# The hostname this instance serves, and the tenant domain it is set up under. It is written into every
# invitation and recovery link the instance mails, and a restore targets the SAME domain (ADR 0056 §4) —
# changing it later is not supported in V1.
VEYQ_DOMAIN=veyq.example.org

# The published image and TAG. A release is `<major>.<minor>` — the value in this repository's VERSION file at
# the commit that published it (ADR 0057 §1). Pin one rather than `latest` or a bare `<major>`, which both move:
# an upgrade migrates the schema at boot with no gate and there is no downgrade path, so the tag you can name is
# the tag you can go back to — and going back means restoring a backup (ADR 0056 §6).
#
# EMPTY, like every other required value here, and the example stays in this comment. Assigned, it would defeat
# its own `${VEYQ_IMAGE:?…}` guard: `<owner>` is not a legal image reference, so a file copied and filled in
# only as far as the secrets passes `docker compose config` and then dies at `up` with `invalid reference
# format` — the one message that does not say which variable to set or where. Measured: `docker image inspect
# 'ghcr.io/<owner>/veyq:1.0'` → invalid reference format.
#
#   e.g. VEYQ_IMAGE=ghcr.io/<owner>/veyq:1.0
VEYQ_IMAGE=

# The administration surface's image (ADR 0065). It ships as part of the SAME release as VEYQ_IMAGE and is
# signed the same way, so pin the same `<major>.<minor>` on both: a mismatched pair is two versions of one
# instance, and only one of them migrated the schema. Empty for the reason above.
#
#   e.g. VEYQ_ADMIN_IMAGE=ghcr.io/<owner>/veyq-admin:1.0
VEYQ_ADMIN_IMAGE=

# Database. The app user; root is used by `docker compose exec` for a backup capture and nothing else.
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Object store. GARAGE_RPC_SECRET authenticates node RPC and must be 64 hex chars; GARAGE_ADMIN_TOKEN guards
# the admin API and is now read by TWO services — the store itself, and the app, which uses it to bring the
# store from running to usable on first start (ADR 0067: layout, bucket, key, grant, CORS policy — there is no
# init sidecar and this recipe builds nothing). The S3 key pair is what the app signs presigned URLs with, what
# it imports INTO the store when it provisions it, and what a backup capture reads the bucket with — the same
# pair in all three places by design.
#
# VEYQ_S3_ACCESS_KEY must be a Garage key id: `GK` followed by 24 hex characters. The store rejects any other
# shape, and it does so during provisioning rather than at startup — `GET /api/instance/store-provisioning`
# reports FAILED and the app log names the step.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
VEYQ_S3_ACCESS_KEY=
VEYQ_S3_SECRET_KEY=

# Let's Encrypt account address for the automatic certificate. TLS is not optional here: the refresh cookie is
# `Secure` by default and every mailed link is https, so an HTTP-only instance has a silently broken
# "remember me" and mails links to a scheme it does not answer.
VEYQ_ACME_EMAIL=

# OPTIONAL — the administration surface's exposure (ADR 0065). Two modes, one image:
#
#   * LEAVE ADMIN_DOMAIN UNSET (the default and the safer one). No Traefik router is created at all; the
#     surface is published only on 127.0.0.1 of the host, so nothing on the internet can reach it. Get to it
#     with an SSH tunnel — `ssh -L 8081:127.0.0.1:8081 you@the-host`, then http://localhost:8081. This is also
#     how you bootstrap a NEW instance: first-run setup lives here, and over localhost it needs no DNS and no
#     certificate, so you can create the first account before VEYQ_DOMAIN resolves anywhere.
#   * SET ADMIN_DOMAIN to give it its own hostname and certificate. Point that name's DNS at this host FIRST —
#     Let's Encrypt validates over HTTP-01 on :80, and a name that does not resolve yet burns failed orders
#     against the rate limit. Choose a name you do not publish anywhere: the surface is not linked from the
#     app, and an unlisted name is one more layer between a stranger and the highest-privilege page here.
#
#   ADMIN_DOMAIN=admin.veyq.example.org
# OPTIONAL — the host port the localhost-only mode binds (127.0.0.1 only, never 0.0.0.0). Default 8081.
#   ADMIN_PORT=8081
# OPTIONAL — override while testing a deployment. Production locks a hostname out for an hour after 5 failed
# validations and caps issuance at 50 certificates per registered domain per week; staging certificates are not
# browser-trusted, so remove this before the instance is used:
#   VEYQ_ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# OPTIONAL — the app container's memory limit; the JVM sizes its heap as a percentage of it. Default 1g.
#   VEYQ_MEM_LIMIT=1g
