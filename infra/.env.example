# The template for an instance's .env, which infra/docker-compose.prod.yml reads. A release carries it as the
# asset `env.example` (a GitHub Release asset cannot keep the leading period), and `veyqctl install` writes the
# instance's .env from it: the four secrets generated, the two image lines from the release's manifest, every other
# assigned value given with `--set KEY=VALUE` or asked for (ADR 0096). By hand:
#
#     (umask 077; cp releases/<release>/env.example .env)      # then fill in every value below
#
# Every variable assigned here is REQUIRED except where noted: the compose file declares them as `${VAR:?…}`, so a
# missing one fails the `up` instead of defaulting to something. A prod stack that boots with a placeholder is
# worse than one that refuses to boot. The optional ones are the commented-out lines at the end.
#
# veyqctl generates the four random secrets; by hand, generate them with:
#     openssl rand -hex 32          # GARAGE_RPC_SECRET (must be exactly 64 hex chars)
#     openssl rand -base64 24       # MARIADB_PASSWORD, MARIADB_ROOT_PASSWORD and GARAGE_ADMIN_TOKEN
#
# This file is the operator's copy of the instance's identity. Losing MARIADB_PASSWORD locks you out of your
# own database; losing the config-secret KEK on the `veyq-config-secret` volume is the separate, quieter loss
# that https://raddatzk.github.io/veyq/run/backup-and-restore/ is about.

# The release line `veyqctl` keeps this instance on (ADR 0096 decision 4); Compose does not read it. `<major>.<minor>`
# pins one release and `upgrade` never leaves it; `<major>` takes the newest release of that major; `latest` the
# newest of all, entering each new major only from the last release of the one before. A snapshot is never taken.
VEYQ_RELEASE=latest

# The hostname this instance serves, and the tenant domain it is set up under. It is written into every
# invitation and recovery link the instance mails, and a restore targets the SAME domain (ADR 0056 §4) —
# changing it later is not supported in V1.
VEYQ_DOMAIN=veyq.example.org

# The published image, as `<tag>@<digest>`: `veyqctl` writes this line and the next from the release's
# manifest.json, which names both images that way, and never lets `--set` change them. A release is `<major>.<minor>`
# (ADR 0057 §1) and never moves; an upgrade migrates the schema at boot with no gate and there is no downgrade path,
# so the release you can name is the one you can go back to — and going back means restoring a backup (ADR 0056 §6).
#
# EMPTY, like the secrets below, and the example stays in this comment. Assigned, it would defeat
# its own `${VEYQ_IMAGE:?…}` guard: `<digest>` is not a legal image reference, so a file copied and filled in
# only as far as the secrets passes `docker compose config` and then dies at `up` with `invalid reference
# format` — the one message that does not say which variable to set or where. Measured: `docker image inspect
# 'ghcr.io/raddatzk/veyq:1.0@sha256:<digest>'` → invalid reference format.
#
#   e.g. VEYQ_IMAGE=ghcr.io/raddatzk/veyq:1.0@sha256:<digest>   — the manifest's `images.app`, verified as https://raddatzk.github.io/veyq/run/verify-a-release/ shows
VEYQ_IMAGE=

# The administration surface's image (ADR 0065). It ships as part of the SAME release as VEYQ_IMAGE and is
# signed the same way, so pin the same `<major>.<minor>` on both: a mismatched pair is two versions of one
# instance, and only one of them migrated the schema. Empty for the reason above.
#
#   e.g. VEYQ_ADMIN_IMAGE=ghcr.io/raddatzk/veyq-admin:1.0@sha256:<digest>
VEYQ_ADMIN_IMAGE=

# Database. The app user; root is used by `docker compose exec` for a backup capture and nothing else.
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Bundled object store. GARAGE_RPC_SECRET authenticates node RPC and must be 64 hex chars; GARAGE_ADMIN_TOKEN guards
# the admin API and is read by TWO services — the store itself, and the app, which uses it to bring the store
# from running to usable on first start (ADR 0067: layout, bucket, key, grant, CORS policy — there is no init
# sidecar and this recipe builds nothing). The app's S3 key pair is DERIVED from this token, the same way by the
# app and by a backup capture (ADR 0089), so there is no access key or secret key to set here.
#
# These two are the whole store configuration this file holds. The store itself is a setting: after the first
# start, the Server Owner chooses the bundled store (or enters an S3-compatible one) in the admin console under
# Server → Object store, and checks it — a tenant cannot be created before that check has passed.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Let's Encrypt account address for the automatic certificate. TLS is not optional here: the refresh cookie is
# `Secure` by default and every mailed link is https, so an HTTP-only instance has a silently broken
# "remember me" and mails links to a scheme it does not answer.
VEYQ_ACME_EMAIL=

# OPTIONAL — the administration surface's exposure (ADR 0065). Two modes, one image:
#
#   * LEAVE ADMIN_DOMAIN UNSET (the default and the safer one). No Traefik router is created at all; the
#     surface is published only on 127.0.0.1 of the host, so nothing on the internet can reach it. Get to it
#     with an SSH tunnel — `ssh -L 8081:127.0.0.1:8081 you@the-host`, then http://localhost:8081. This is also
#     how you bootstrap a NEW instance: first-run setup lives here, and over localhost it needs no DNS and no
#     certificate, so you can create the first account before VEYQ_DOMAIN resolves anywhere.
#   * SET ADMIN_DOMAIN to give it its own hostname and certificate. Point that name's DNS at this host FIRST —
#     Let's Encrypt validates over HTTP-01 on :80, and a name that does not resolve yet burns failed orders
#     against the rate limit. Choose a name you do not publish anywhere: the surface is not linked from the
#     app, and an unlisted name is one more layer between a stranger and the highest-privilege page here.
#
#   ADMIN_DOMAIN=admin.veyq.example.org
# OPTIONAL — the host port the localhost-only mode binds (127.0.0.1 only, never 0.0.0.0). Default 8081.
#   ADMIN_PORT=8081
# OPTIONAL — override while testing a deployment. Production locks a hostname out for an hour after 5 failed
# validations and caps issuance at 50 certificates per registered domain per week; staging certificates are not
# browser-trusted, so remove this before the instance is used:
#   VEYQ_ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# OPTIONAL — Strict-Transport-Security (180 days, no includeSubDomains, no preload). On by default. Turn it off
# only if this hostname is also served over plain HTTP somewhere, or if a proxy of your own in front of this
# stack already sets the header — and know that a browser which saw it keeps it for the full 180 days
# (https://raddatzk.github.io/veyq/run/new-instance/).
#   VEYQ_HSTS_ENABLED=false
# OPTIONAL — the app container's memory limit; the JVM sizes its heap as a percentage of it. Default 1g.
#   VEYQ_MEM_LIMIT=1g
