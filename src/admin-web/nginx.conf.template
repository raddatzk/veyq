# The admin container's whole server config (ADR 0065). Two things and no more: serve the built SPA, and
# reverse-proxy /api/* to the backend from THIS origin.
#
# Why the proxy at all — it is not convenience. The Server-Owner session's refresh token rides an httpOnly,
# same-origin cookie (cr-0055). If this app called the instance's public domain directly, every deployment
# where ADMIN_DOMAIN differs from VEYQ_DOMAIN would be cross-origin, and the refresh cookie would be set on a
# domain this page cannot send it back from. Proxying makes the browser see ONE origin — whatever address the
# operator reaches this container at, including plain `http://localhost:<port>` with no DNS at all, which is
# what lets first-run setup happen before VEYQ_DOMAIN resolves anywhere.
#
# BACKEND_URL, VEYQ_RESOLVERS and VEYQ_HSTS_OFF are the only substituted values; see
# /docker-entrypoint.d/30-veyq-backend-url.sh, which passes exactly those three names to envsubst so nginx's own
# `$host`/`$uri` variables survive. (Named here without the dollar-brace form on purpose: envsubst rewrites
# comments too, so spelling them that way would print their rendered values into this text.)

# The request log keeps WHEN, WHAT method on WHICH path, and the answer — never WHO, and never a query string
# (ADR 0092 § 5, owner Q29). Not the client's address, its User-Agent or X-Forwarded-For: on the recipe's loopback
# binding (Compose) and a port-forward (Helm) the address names the bridge or 127.0.0.1, never a person, and where an
# operator exposes the console it would name one with no time bound, since a quiet console's log rotates by size
# almost never. `accessLog.test.ts` reds on any of them in a log format. The base image's `main` format logs `$request` (the whole request line,
# query included) and the Referer (another page's full URL) to stdout, where the operator's log driver keeps
# them and no wire sweep reads them (cc.security.wire-assertion). No admin flow puts a token in a URI today:
# the SPA's routes take no query, the Admin API's path parameters are opaque ids, its one query is a boolean,
# and every credential rides the Authorization header or the refresh cookie, neither logged. So this trims what
# nothing legitimate uses, so that a token a future change — or a stray request — puts in a query cannot land
# in a log. `$request_uri` is the raw target as sent; the map keeps everything before the first `?`.
# NOT covered, and it cannot be: when nginx logs an error (the backend unresolvable or down, a 502), the error log
# names the whole request line, query included — measured on 1.30.5 — and the hop that reached it: loopback or the
# container bridge on the recipe's binding (ADR 0092 § 5 and its Still open 2). nginx has no knob for that context,
# and that log line is the one diagnostic this container exists to give, so it stays at nginx's default.
map $request_uri $veyq_request_path {
    "~^(?<veyq_path>[^?]*)" $veyq_path;
}
log_format veyq '[$time_local] "$request_method $veyq_request_path $server_protocol" $status $body_bytes_sent';

server {
    # Replaces the base image's http-level `access_log … main`: a server that declares its own inherits none.
    access_log /dev/stdout veyq;

    # 8080, not 80: the image runs as uid 101 (nginx-unprivileged, see src/admin-web/Dockerfile), and a non-root
    # process cannot bind a port below 1024. Deployments map it — compose to 127.0.0.1:${ADMIN_PORT}, the chart
    # to a ClusterIP Service.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Drops the VERSION from the `Server:` header (the name itself stays — nginx has no directive to remove
    # it). This surface is the highest-privilege thing the instance serves, and a version banner is free
    # reconnaissance for anyone who reached it at all.
    server_tokens off;

    # The console's security headers. The Content-Security-Policy is sent here as a header, its one delivery: a header
    # can carry `frame-ancestors`, which a <meta> ignores. Its value is `ADMIN_CSP` (src/shared/security/csp.ts), which
    # `csp.test.ts` holds equal to the line below - edit both. X-Frame-Options stays for a browser older than
    # frame-ancestors. COOP: the console keeps no handle on a page it opens, nor that page on it; it opens no popup that
    # talks back. CORP: no other origin embeds or reads a response of this origin no-cors. The Permissions-Policy grants
    # the one feature the console uses, `clipboard-write` (copying an invite link and an order's text), to this origin,
    # and switches every other off. The robots noindex is belt-and-braces with the page's own <meta name="robots">.
    #
    # TRAP, and why `add_header_inherit merge` is here: by default `add_header` does NOT merge across levels — a
    # location that declares even one `add_header` of its own inherits NONE of the server-level ones. That bit
    # here: `= /index.html` sets `Cache-Control`, and it is where `try_files` sends every SPA route, so the
    # security headers were measurably absent from the one response that matters most until they were repeated
    # there by hand. `merge` (nginx 1.29.3+) appends this level's set to every location's own instead. It is set
    # once, here: a location that does not declare the directive takes the server's value (the headers module
    # merges it like any other setting), so a future location's `add_header` ADDS to this set, never replaces it.
    add_header_inherit merge;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'sha256-60LHlRjW/B3CtzIoE/Lf1/NEDvko9efWMFaGVhHu/cs=' 'sha256-0sLsI2a+NIcumVvBF9zD/ArGqlZR2xfnxsALPmK7nj8='; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.pwnedpasswords.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Frame-Options DENY always;
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Resource-Policy same-origin always;
    add_header Permissions-Policy "clipboard-write=(self), accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), storage-access=(), usb=(), window-management=(), xr-spatial-tracking=()" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    # HSTS — the app's value under the app's switch; docs/crosscutting/cc.security.csp.md § admin-web owns both
    # the decision and the value (180 days, no includeSubDomains, no preload). The entrypoint hook renders the
    # VEYQ_HSTS_OFF placeholder as nothing when VEYQ_HSTS_ENABLED is `true` (its default) and as `#` when `false`,
    # so the directive is either rendered whole or commented out — never sent with an empty value, whose effect
    # the nginx docs do not define. Sent whatever the scheme: this nginx listens on plain 8080 behind whatever
    # terminates TLS and cannot tell which case it is in; a browser ignores the header over plain HTTP.
    ${VEYQ_HSTS_OFF}add_header Strict-Transport-Security "max-age=15552000" always;

    location /api/ {
        # Resolve the upstream at REQUEST time, not at config-parse time. A literal `proxy_pass http://app:8090`
        # makes nginx resolve `app` while reading the config, so the container refuses to start at all when the
        # backend is not up or not resolvable yet — measured: `nginx: [emerg] host not found in upstream`, exit
        # before serving a byte. That is the wrong failure for this surface in particular: the admin container
        # is the one an operator reaches to bootstrap or to diagnose an instance, so it must come up and say
        # what is wrong rather than crash-loop alongside whatever it was meant to help fix. With the upstream
        # in a variable, an unreachable backend is a 502 on /api/* and the console still loads.
        resolver ${VEYQ_RESOLVERS} valid=10s;
        set $veyq_backend ${BACKEND_URL};
        proxy_pass $veyq_backend$request_uri;

        # The backend resolves the tenant from the Host, and the Server-Owner endpoints are tenant-independent,
        # so the Host is forwarded unchanged rather than rewritten to the upstream's name.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        # Argon2id at production params runs in the BROWSER, but the setup POST that follows it carries the
        # whole cold account birth; a short upstream timeout would turn a slow instance into a failed bootstrap.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # SPA history fallback. Everything that is not a real file is the app's own routing (/setup, /login, /).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html must never be cached: it is the only file whose name is stable, so a cached copy pins the
    # operator to a previous build's hashed assets after an upgrade. The hashed assets themselves are immutable.
    # Only `Cache-Control` here: the server-level headers are merged in (`add_header_inherit merge` above).
    location = /index.html {
        add_header Cache-Control "no-store" always;
    }
}
