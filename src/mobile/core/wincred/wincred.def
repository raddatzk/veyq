# Windows' key stores for mingwX64 (ADR 0136's Consequences): DPAPI (crypt32), the Microsoft Passport Key Storage
# Provider (ncrypt) and the Credential Locker (WinRT's PasswordVault, runtimeobject: a received link's guest session,
# ADR 0150 decision 3), reached through veyq_wincred.h's helpers alone; the header and its directory are handed in by
# core/build.gradle.kts. Only that header's declarations are exposed, so windows.h's types stay platform.windows'.
package = me.raddatz.veyq.mobile.wincred
headers = veyq_wincred.h
headerFilter = veyq_wincred.h
compilerOpts = -DUNICODE -D_UNICODE -DWINVER=0x0A00 -D_WIN32_WINNT=0x0A00
linkerOpts = -lncrypt -lcrypt32 -ladvapi32 -lole32 -lruntimeobject
