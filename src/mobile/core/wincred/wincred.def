# Windows' key stores for mingwX64 (ADR 0129's Consequences): DPAPI (crypt32) and the Microsoft
# Passport Key Storage Provider (ncrypt), reached through veyq_wincred.h's helpers alone; the header and its directory
# are handed in by core/build.gradle.kts. Only that header's declarations are exposed, so windows.h's types stay
# platform.windows'.
package = me.raddatz.veyq.mobile.wincred
headers = veyq_wincred.h
headerFilter = veyq_wincred.h
compilerOpts = -DUNICODE -D_UNICODE -DWINVER=0x0A00 -D_WIN32_WINNT=0x0A00
linkerOpts = -lncrypt -lcrypt32 -ladvapi32 -lole32
