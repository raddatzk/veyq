# libwebp's decoder for the members' pictures where the platform cannot decode a WebP (media/WebpPicture.kt): headers
# and the static library come from build_libwebp.py's output, one slice per target, handed in by core/build.gradle.kts
# (includeDirs, -libraryPath).
package = me.raddatz.veyq.mobile.webp
headers = webp/decode.h
headerFilter = webp/decode.h webp/types.h
compilerOpts = -DWEBP_EXTERN=extern
staticLibraries = libwebpdecoder.a
