<?xml version="1.0" encoding="utf-8"?>
<!-- The languages the app's words come in (src/mobile/words/words.json): Android 13+ offers them as the app's own
     language, in Settings' "Appearance and language" (LocaleManager) and in the system's settings for the app (ADR 0162). -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="de" />
</locale-config>
