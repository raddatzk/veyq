<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose and the system splash (Android 12+): the web's bg role and the brand mark. -->
    <style name="Theme.Veyq" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/veyq_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/veyq_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
