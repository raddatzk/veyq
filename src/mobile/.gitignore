.gradle/
build/
local.properties
.kotlin/
# The Xcode project is generated from apple/project.yml (XcodeGen); the yml is the source.
apple/*.xcodeproj/
apple/build/
# Generated into the asset catalog from the web's tokens and brand mark (theme/generate_theme.py); only its root
# Contents.json is tracked.
apple/Veyq/Assets.xcassets/*/
# cargo's own output, should an editor run it here: linux/run.py keeps its target in a Docker volume.
linux/target/
# .NET's own output beside each C# project of the Windows app (windows/run.py builds them; nothing of it is kept).
windows/**/bin/
windows/**/obj/
windows/**/TestResults/
