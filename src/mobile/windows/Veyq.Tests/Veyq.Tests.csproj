<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app's words, formats and pictures on Windows (ADR 0123's Consequences, the Windows app): the app's own Words,
       MrtWords, Said, AvatarsHeld, PictureDecode, TypedText, PdfPages, PdfWeb, KitDrawing (with Log), ReaderStream, Recent, MediaTiers, MusicRamp, MapPins, ReceivedText, PersonText and TrustWords sources (the last with the wire's generated types) against the .pri its build compiled (VEYQ_PRI), the system's formatters and
       its image codecs. Windows only, an x64 process like the app (run.py runs it on the Windows host with arch x64,
       after the app's build). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Platforms>x64</Platforms>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Veyq.Tests</RootNamespace>
    <WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!-- WebView2's WinRT projection, the app's (PdfWeb, PdfWebTest): the package WinUI brings the app, here direct -->
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Veyq/Words.cs" Link="App/Words.cs" />
    <Compile Include="../Veyq/Core/MrtWords.cs" Link="App/MrtWords.cs" />
    <Compile Include="../Veyq/Core/Lives.cs" Link="App/Lives.cs" />
    <Compile Include="../Veyq/Core/SaidNotice.cs" Link="App/SaidNotice.cs" />
    <Compile Include="../Veyq/Core/AvatarsHeld.cs" Link="App/AvatarsHeld.cs" />
    <Compile Include="../Veyq/Core/PictureDecode.cs" Link="App/PictureDecode.cs" />
    <Compile Include="../Veyq/Core/TrustWords.cs" Link="App/TrustWords.cs" />
    <Compile Include="../Veyq/Core/HeaderPlan.cs" Link="App/HeaderPlan.cs" />
    <Compile Include="../Veyq/Core/ShareDays.cs" Link="App/ShareDays.cs" />
    <Compile Include="../Veyq/Core/TypedText.cs" Link="App/TypedText.cs" />
    <Compile Include="../Veyq/Core/MarkdownBlocks.cs" Link="App/MarkdownBlocks.cs" />
    <Compile Include="../Veyq/Core/PdfPages.cs" Link="App/PdfPages.cs" />
    <Compile Include="../Veyq/Core/PdfWeb.cs" Link="App/PdfWeb.cs" />
    <Compile Include="../Veyq/Core/SvgWeb.cs" Link="App/SvgWeb.cs" />
    <Compile Include="../Veyq/Core/SvgCapture.cs" Link="App/SvgCapture.cs" />
    <Compile Include="../Veyq/Core/KitDrawing.cs" Link="App/KitDrawing.cs" />
    <Compile Include="../Veyq/Core/ProfilePicture.cs" Link="App/ProfilePicture.cs" />
    <Compile Include="../Veyq/Core/Log.cs" Link="App/Log.cs" />
    <Compile Include="../Veyq/Core/ListScrolls.cs" Link="App/ListScrolls.cs" />
    <Compile Include="../Veyq/Core/ReaderStream.cs" Link="App/ReaderStream.cs" />
    <Compile Include="../Veyq/Core/ImportText.cs" Link="App/ImportText.cs" />
    <Compile Include="../Veyq/Core/Recent.cs" Link="App/Recent.cs" />
    <Compile Include="../Veyq/Core/AppearanceKept.cs" Link="App/AppearanceKept.cs" />
    <Compile Include="../Veyq/Core/MediaTiers.cs" Link="App/MediaTiers.cs" />
    <Compile Include="../Veyq/Core/MusicRamp.cs" Link="App/MusicRamp.cs" />
    <Compile Include="../Veyq/Apps/Memories/CurationText.cs" Link="App/CurationText.cs" />
    <Compile Include="../Veyq/Apps/Memories/GalleryText.cs" Link="App/GalleryText.cs" />
    <Compile Include="../Veyq/Core/MapPins.cs" Link="App/MapPins.cs" />
    <Compile Include="../Veyq/Core/SearchPlan.cs" Link="App/SearchPlan.cs" />
    <Compile Include="../Veyq/Core/ReceivedText.cs" Link="App/ReceivedText.cs" />
    <Compile Include="../Veyq/Core/PersonText.cs" Link="App/PersonText.cs" />
    <Compile Include="$(VeyqGenerated)bridge/Bridge.g.cs" Link="App/Bridge.g.cs" />
    <Compile Include="$(VeyqGenerated)words/windows/Words.g.cs" Link="App/Words.g.cs" />
  </ItemGroup>
</Project>
