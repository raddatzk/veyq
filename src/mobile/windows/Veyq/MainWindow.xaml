<Window
    x:Class="Veyq.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid x:Name="Root">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
      <TextBlock x:Name="Heading" AutomationProperties.AutomationId="heading" HorizontalAlignment="Center"
                 Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock x:Name="Status" AutomationProperties.AutomationId="status" HorizontalAlignment="Center"
                 TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
