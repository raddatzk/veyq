<Window
    x:Class="Veyq.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <!-- The window's three faces, one shown at a time: what shows while the core opens or refuses, the sign-in or unlock, the shell
       (MainWindow.xaml.cs puts the sign-in, the unlock and the shell in Faces). -->
  <Grid x:Name="Root">
    <StackPanel x:Name="Opening" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
      <TextBlock x:Name="Heading" AutomationProperties.AutomationId="heading" HorizontalAlignment="Center"
                 Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock x:Name="Status" AutomationProperties.AutomationId="status" HorizontalAlignment="Center"
                 TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center" />
    </StackPanel>
    <ContentControl x:Name="Faces" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Visibility="Collapsed" />
  </Grid>
</Window>
