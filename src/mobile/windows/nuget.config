<?xml version="1.0" encoding="utf-8"?>
<!-- Every package of the Windows app comes from nuget.org alone (ADR 0123's Consequences, the Windows app): no other
     source a machine's own NuGet config adds, and each package mapped to it by name. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
