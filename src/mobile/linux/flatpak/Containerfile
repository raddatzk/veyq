# Where the Linux app's Flatpak is built (ADR 0133 decision 11): Fedora's own flatpak and flatpak-builder, nothing else.
# The runtime, the SDK and the Rust extension are not in the image: `run.py flatpak` installs them from Flathub into a
# named volume at the commits `runtime.pins` names, so the image holds tools only. It runs with `--privileged`:
# flatpak-builder runs every build step in bubblewrap, which needs the mount and user namespaces Docker's default
# profile refuses.
#
# By digest (scripts/validate_image_pins.py): the same fedora:44 index the app's development image beside it builds from
# (one repository, one tag), read with `docker buildx imagetools inspect fedora:44` on 2026-11-10.
FROM fedora:44@sha256:15da97ed9aa94dd3d92c3925eb89520f6c80e07ea7ee24cba848d1f8b6912b3e

# flatpak, flatpak-builder: the build, the export and the bundle. appstream: `appstreamcli validate` of the metainfo.
# dbus-daemon: `dbus-run-session` for `run.py flatpak --smoke`'s `flatpak uninstall --delete-data`, which clears the
# app's permissions over a session bus and stops without one ("Cannot autolaunch D-Bus", measured 2026-11-13).
RUN dnf install -y --setopt=install_weak_deps=False flatpak flatpak-builder appstream dbus-daemon \
    && dnf clean all
