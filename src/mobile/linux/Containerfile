# The Linux app's build and run environment (ADR 0123's Consequences, the Linux app): Fedora 44, whose GTK 4.22 and libadwaita
# 1.9 the app is written against. `run.py` builds this image and runs everything Linux in it — the core's test binary,
# the bridge's C smoke, cargo and the app under gtk4-broadwayd. Nothing is copied in: run.py mounts what a run reads.
#
# By digest (scripts/validate_image_pins.py): the multi-arch index of fedora:44, read with
# `docker buildx imagetools inspect fedora:44` on 2026-11-10 (linux/amd64 and linux/arm64/v8).
FROM fedora:44@sha256:15da97ed9aa94dd3d92c3925eb89520f6c80e07ea7ee24cba848d1f8b6912b3e

# gtk4-devel, libadwaita-devel, rust, cargo, clippy, gcc, gettext: the app's build (`run.py build`; gettext's msgfmt
#   compiles the words' catalogs, glib2-devel's glib-compile-resources — gtk4-devel's dependency — the theme).
# libxcrypt-compat: libcrypt.so.1, the one library Ktor's statically linked libcurl needs beyond glibc, zlib and
#   libresolv (src/mobile/CLAUDE.md § Traps).
# ca-certificates, tzdata: the system's CA bundle the Curl engine verifies against, and the zones kotlinx-datetime reads.
# glibc-langpack-en, glibc-langpack-de: the locales the words are tried in — glibc's gettext ignores LANGUAGE under a C
#   locale (C.UTF-8 included: measured 2026-11-10, `gettext --context` answered the English), as a desktop never runs.
# socat: run.py's forward of a `*.localhost` dev origin to the host (the backend picks the tenant from the Host header).
# libsecret: what the core's LinuxDeviceKeys loads at run time (`dlopen("libsecret-1.so.0")`, core/secret/), the one
#   thing of these the app itself needs. gnome-keyring, dbus-daemon: the Secret Service `run.py test` holds the core's
#   DeviceKeys contract against — gnome-keyring-daemon under `dbus-run-session`, its login collection unlocked by a
#   password drawn in the container per run (ADR 0129's Consequences); test-only.
# poppler-glib-devel: a receipt's PDF drawn by GNOME's own PDF stack (poppler-glib through poppler-rs, D4 of the Expenses
#   CR), from the bytes in memory; a Flatpak's runtime must carry poppler-glib.
RUN dnf install -y --setopt=install_weak_deps=False \
        gtk4-devel libadwaita-devel poppler-glib-devel rust cargo clippy gcc gettext \
        libxcrypt-compat ca-certificates tzdata glibc-langpack-en glibc-langpack-de socat \
        libsecret gnome-keyring dbus-daemon \
    && dnf clean all
