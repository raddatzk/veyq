### Vue ###
# gitignore template for Vue.js projects
#
# Recommended template: Node.gitignore

### Vuejs ###
# Recommended template: Node.gitignore

node_modules/
dist/
# The admin CLI bundle (ADR 0065) — built by `npm run build:cli`, next to but not inside `dist/`,
# because it is a Node program and not part of the static site nginx serves.
dist-cli/
npm-debug.log
yarn-error.log
playwright-report/
test-results/

# veyq local wiki diagram preview (scripts/render-diagrams.sh)
.wiki-preview/

# Local deployment secrets
infra/.env
# Instance backups (scripts/instance_backup.py). The dump is the whole instance, and a capture told
# `--key-beside-dump` also holds the config-secret KEK — this directory must never become a commit.
# `.dockerignore` keeps it out of the build context for the same reason.
infra/backups/
# Local dev secrets — Quarkus dev-mode auto-loads backend/.env (SMTP creds, real cloud keys); keep it untracked.
backend/.env
load/k6/users.local.json
!load/k6/users.local.example.json

