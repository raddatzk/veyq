# Local dev principal (cr-0075): throwaway creds + derived key material for a local instance, filled by
# `npm run bootstrap:user`. Never committed; `.run/.env.example` is the tracked template.
.run/.env

### Git ###
# Created by git for backups. To disable backups in Git:
# $ git config --global mergetool.keepBackup false
*.orig

# Created by git when using merge tools for conflicts
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
*_BACKUP_*.txt
*_BASE_*.txt
*_LOCAL_*.txt
*_REMOTE_*.txt

